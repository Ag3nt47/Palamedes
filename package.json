{
  "name": "palamedes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An extensible local-first scientific, graphing, and symbolic math workspace.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "desktop:dev": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jstat": "^1.9.6",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.0.0",
    "nerdamer": "^1.1.13",
    "plotly.js-dist-min": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "Ag3nt47",
    "email": "Ag3nt47@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ag3nt47/Palamedes.git"
  },
  "homepage": "https://ag3nt47.github.io/Palamedes/",
  "build": {
    "appId": "io.github.ag3nt47.palamedes",
    "productName": "Palamedes",
    "copyright": "Copyright © 2026 Ag3nt47",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "Palamedes-Setup-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Palamedes"
    },
    "publish": {
      "provider": "github",
      "owner": "Ag3nt47",
      "repo": "Palamedes",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Palamedes-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "icon": "public/icon.png",
      "identity": "-"
    },
    "linux": {
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Palamedes-${version}-linux-${arch}.${ext}",
      "maintainer": "Ag3nt47 <Ag3nt47@users.noreply.github.com>",
      "icon": "public/icon.png"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "palamedesDesktop": {
    "signedMacUpdates": false
  }
}
